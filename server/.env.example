# Copy to .env and fill in. Every value here is free-tier.
PORT=8080

# Shared secret the extension and dashboard send as the x-api-key header.
CLIENT_TOKEN=change-me

# MongoDB Atlas M0 connection string. Leave empty to use an in-memory cache.
MONGODB_URI=

# How long extracted product facts stay cached (hours).
CACHE_TTL_HOURS=48

# --- LLM API tree -------------------------------------------------------------
# Each provider accepts several keys, comma-separated. Leave a provider's key
# empty to disable it. Model names change often: override *_MODEL if a default
# stops working. Lower PRIORITY is tried first.

GROQ_API_KEYS=
GROQ_MODEL=llama-3.1-8b-instant

CEREBRAS_API_KEYS=
CEREBRAS_MODEL=llama3.1-8b

GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite

OPENROUTER_API_KEYS=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

MISTRAL_API_KEYS=
MISTRAL_MODEL=mistral-small-latest

GITHUB_MODELS_TOKENS=
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini

SAMBANOVA_API_KEYS=
SAMBANOVA_MODEL=Meta-Llama-3.1-8B-Instruct

NVIDIA_API_KEYS=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKENS=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# Router tuning
LLM_TIMEOUT_MS=4000
LLM_HEDGE_MS=1500
LLM_MAX_ATTEMPTS=4
