# Copy to .env and fill in. Every value here is free-tier.
PORT=8080

# Shared secret the extension and dashboard send as the x-api-key header.
CLIENT_TOKEN=change-me

# MongoDB Atlas M0 connection string. Leave empty to use an in-memory cache.
MONGODB_URI=

# How long extracted product facts stay cached (hours).
CACHE_TTL_HOURS=48

# --- LLM API tree -------------------------------------------------------------
# Each provider accepts several keys, comma-separated. Leave a provider's key
# empty to disable it. Model names change often: run `npm run check:models`
# to see which work, and override *_MODEL if a default stops working.

# Gemini is the main provider. Its free limits apply per model, per Google
# Cloud project, so:
#  - make ONE key per project (keys in the same project share limits), and
#  - every model listed below becomes its own slot with its own limits.
GEMINI_API_KEYS=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-31b-it,gemma-4-26b-a4b-it,gemini-2.5-flash-lite,gemini-2.5-flash,gemini-3-flash-preview

GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-20b

CEREBRAS_API_KEYS=
CEREBRAS_MODEL=llama3.1-8b

OPENROUTER_API_KEYS=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

MISTRAL_API_KEYS=
MISTRAL_MODEL=mistral-small-latest

GITHUB_MODELS_TOKENS=
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini

SAMBANOVA_API_KEYS=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

NVIDIA_API_KEYS=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKENS=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# Optional extra request fields per provider, as JSON. gpt-oss and full Gemini
# Flash models get {"reasoning_effort":"low"} automatically. Example:
# GROQ_EXTRA_BODY={"reasoning_effort":"low"}

# --- Reliability over speed ---------------------------------------------------
# Products per LLM call. 1 = most reliable (no mixing up products).
BATCH_SIZE=1
# Per-call timeout, delay before a backup call to another key, and attempts.
LLM_TIMEOUT_MS=15000
LLM_HEDGE_MS=6000
LLM_MAX_ATTEMPTS=8
# How long a request waits for a free key before reporting "busy".
LLM_QUEUE_MS=60000
